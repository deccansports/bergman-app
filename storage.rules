
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // General rule: By default, deny all reads and writes
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow public read access for event images and course maps
    match /event-images/{eventId}/{fileName} {
      allow read;
    }
    match /course-maps/{eventId}/{mapType}/{fileName} {
      allow read;
    }
    
    // Allow public read for club logos
    match /club-logos/{clubId}/{fileName} {
      allow read;
    }
    
    // Allow public read for sponsor logos
    match /sponsors/{eventId}/{fileName} {
      allow read;
    }

    // Allow authenticated users to write their own profile pictures
    match /profilePictures/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any user to upload their ID proofs during registration, with a size limit.
    // Admin can read these files.
    match /eventRegistrations/{eventId}/idProofs/{fileName} {
      allow write: if request.resource.size < 1 * 1024 * 1024; // 1MB size limit
      allow read: if request.auth != null; 
    }
  }
}
