<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8"/>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="x-apple-disable-message-reformatting"/>
  <title>{{ params.event_name }} — Your Influencer Collab Kit</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Bebas+Neue&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background-color: #05080e;
      color: #eef4ff;
      margin: 0;
      padding: 0;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    /* ── WRAPPER ── */
    .email-wrapper {
      width: 100%;
      background-color: #05080e;
      padding: 0;
      margin: 0;
    }
    .email-container {
      max-width: 640px;
      margin: 0 auto;
      background-color: #05080e;
    }

    /* ══════════════════════════
       LOGO HEADER
    ══════════════════════════ */
    .logo-header {
      background-color: #080d18;
      border-bottom: 1px solid rgba(0,200,255,0.12);
      padding: 20px 28px;
    }
    .logo-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .logo-wordmark {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 34px;
      letter-spacing: 6px;
      line-height: 1;
    }
    .lw-berg { color: #eef4ff; }
    .lw-man  { color: #00c8ff; }
    .logo-tagline {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #3d5068;
      margin-top: 3px;
    }
    .logo-badge {
      background-color: #ff6b00;
      color: #ffffff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 100px;
    }

    /* ══════════════════════════
       TOPBAR
    ══════════════════════════ */
    .topbar {
      background-color: #0c1220;
      border-bottom: 1px solid rgba(0,200,255,0.09);
      padding: 14px 28px;
    }
    .topbar-event {
      font-size: 15px;
      font-weight: 800;
      color: #eef4ff;
      line-height: 1;
    }
    .topbar-sub {
      font-size: 11px;
      color: #3d5068;
      margin-top: 4px;
      letter-spacing: 0.4px;
    }
    .topbar-sub span {
      color: #00c8ff;
      font-weight: 700;
    }

    /* ══════════════════════════
       HERO BANNER
    ══════════════════════════ */
    .hero {
      background: linear-gradient(155deg, #080f1e 0%, #05080e 100%);
      border-left: 1px solid rgba(0,200,255,0.09);
      border-right: 1px solid rgba(0,200,255,0.09);
      padding: 0;
      overflow: hidden;
    }
    .hero-image-wrap {
      position: relative;
      width: 100%;
      line-height: 0;
    }
    .hero-image {
      width: 100%;
      max-height: 340px;
      object-fit: cover;
      display: block;
    }
    .hero-overlay {
      background: linear-gradient(0deg, rgba(4,8,14,0.95) 0%, rgba(4,8,14,0.5) 50%, transparent 100%);
      padding: 20px 28px 24px;
    }
    .hero-tag {
      display: inline-block;
      background-color: rgba(0,200,255,0.10);
      border: 1px solid rgba(0,200,255,0.30);
      border-radius: 100px;
      padding: 5px 14px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #00c8ff;
      margin-bottom: 14px;
    }
    .hero-headline {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 52px;
      line-height: 0.93;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }
    .hl-1 { display: block; color: #eef4ff; }
    .hl-2 { display: block; color: #00c8ff; }
    .hl-3 { display: block; color: #ff6b00; }
    .hero-sub {
      font-size: 13px;
      color: #3d5068;
      line-height: 1.8;
      border-left: 3px solid #ff6b00;
      padding-left: 13px;
      margin-bottom: 22px;
    }

    /* Hero stats strip */
    .hero-stats {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .hstat {
      background-color: rgba(0,200,255,0.05);
      border: 1px solid rgba(0,200,255,0.12);
      border-radius: 10px;
      padding: 10px 16px;
      flex: 1;
      min-width: 100px;
      text-align: center;
    }
    .hstat-num {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 22px;
      letter-spacing: 1px;
      line-height: 1;
      color: #00c8ff;
    }
    .hstat-num-g { color: #aaff00; }
    .hstat-num-a { color: #ff6b00; }
    .hstat-lbl {
      font-size: 9px;
      color: #3d5068;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 3px;
    }

    /* ══════════════════════════
       MAIN CARD
    ══════════════════════════ */
    .main-card {
      background-color: #080d18;
      border: 1px solid rgba(0,200,255,0.09);
      border-top: none;
      padding: 36px 32px;
    }

    /* Divider */
    .divider {
      height: 1px;
      background: linear-gradient(90deg, #00c8ff, #aaff00, #ff6b00, transparent);
      margin: 28px 0;
      border: none;
    }

    /* Section label */
    .section-label {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #3d5068;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(0,200,255,0.09);
    }

    /* ══════════════════════════
       OFFICIAL LETTER
    ══════════════════════════ */
    .official-letter {
      background-color: #0c1220;
      border: 1px solid rgba(0,200,255,0.09);
      border-left: 3px solid #00c8ff;
      border-radius: 14px;
      padding: 26px 28px;
      margin-bottom: 0;
    }
    .ol-salute {
      font-size: 11px;
      font-weight: 700;
      color: #3d5068;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .ol-greeting {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 28px;
      letter-spacing: 2px;
      color: #eef4ff;
      line-height: 1;
      margin-bottom: 20px;
    }
    .ol-body {
      font-size: 14px;
      line-height: 1.85;
      color: rgba(238,244,255,0.86);
    }
    .ol-body p { margin-bottom: 14px; }
    .ol-event-name { color: #00c8ff; font-weight: 800; }

    /* Kit list */
    .ol-kit-list {
      background-color: rgba(0,200,255,0.04);
      border: 1px solid rgba(0,200,255,0.12);
      border-radius: 10px;
      padding: 16px 20px;
      margin: 0 0 14px 0;
      list-style: none;
    }
    .ol-kit-list li {
      font-size: 14px;
      font-weight: 600;
      color: #eef4ff;
      padding: 6px 0;
      border-bottom: 1px solid rgba(0,200,255,0.06);
    }
    .ol-kit-list li:last-child { border-bottom: none; }

    /* Highlight box */
    .ol-highlight {
      background-color: rgba(0,200,255,0.06);
      border: 1px solid rgba(0,200,255,0.20);
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 14px;
      color: #eef4ff;
      line-height: 1.7;
      margin-bottom: 14px;
    }

    /* Urgency box */
    .ol-urgent {
      background-color: rgba(255,107,0,0.07);
      border: 1px solid rgba(255,107,0,0.25);
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 14px;
      color: #eef4ff;
      line-height: 1.6;
      margin-bottom: 14px;
    }
    .ol-urgent-label {
      color: #ff6b00;
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    /* Important box */
    .ol-important {
      background-color: rgba(245,197,24,0.05);
      border: 1px solid rgba(245,197,24,0.22);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 14px;
    }
    .ol-important-head {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #f5c518;
      margin-bottom: 12px;
    }
    .ol-important-list {
      list-style: none;
      padding: 0; margin: 0;
    }
    .ol-important-list li {
      font-size: 13px;
      color: rgba(238,244,255,0.82);
      padding: 5px 0;
      padding-left: 14px;
      position: relative;
      line-height: 1.5;
    }
    .ol-important-list li::before {
      content: '•';
      color: #f5c518;
      font-weight: 800;
      position: absolute;
      left: 0;
    }
    .ol-handle {
      color: #00c8ff;
      font-weight: 700;
      background-color: rgba(0,200,255,0.08);
      border: 1px solid rgba(0,200,255,0.22);
      border-radius: 4px;
      padding: 1px 7px;
      font-size: 12px;
    }
    .ol-reshare  { color: #aaff00; font-weight: 600; font-size: 14px; margin-bottom: 10px; }
    .ol-together { font-size: 15px; font-weight: 700; color: #eef4ff; margin-bottom: 10px; }
    .ol-reach    { font-size: 13px; color: #3d5068; margin-bottom: 0; }

    /* Signature */
    .ol-sig {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid rgba(0,200,255,0.09);
    }
    .ol-sig-regards { font-size: 12px; color: #3d5068; margin-bottom: 5px; }
    .ol-sig-name {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 28px;
      letter-spacing: 2px;
      color: #eef4ff;
      line-height: 1;
    }
    .ol-sig-title {
      font-size: 11px;
      font-weight: 700;
      color: #3d5068;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-top: 3px;
    }
    .ol-sig-brand {
      font-size: 12px;
      font-weight: 800;
      color: #00c8ff;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-top: 6px;
    }

    /* ══════════════════════════
       IMAGE ASSET CARDS
    ══════════════════════════ */
    .assets-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 12px;
      margin: 0 -12px;
    }
    .asset-card {
      background-color: #0a1020;
      border: 1px solid rgba(0,200,255,0.12);
      border-radius: 14px;
      overflow: hidden;
      vertical-align: top;
      width: 50%;
    }
    .asset-card-header {
      padding: 12px 15px;
      border-bottom: 1px solid rgba(0,200,255,0.09);
    }
    .ac-post-header  { border-top: 2px solid #00c8ff; }
    .ac-story-header { border-top: 2px solid #ff6b00; }
    .ah-label {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #eef4ff;
    }
    .ah-sub {
      font-size: 10px;
      color: #3d5068;
      margin-top: 2px;
    }
    .ah-dim {
      display: inline-block;
      margin-top: 6px;
      font-size: 10px;
      font-weight: 700;
      font-family: monospace;
      background-color: rgba(0,200,255,0.08);
      border: 1px solid rgba(0,200,255,0.22);
      color: #00c8ff;
      padding: 2px 8px;
      border-radius: 5px;
    }
    .ah-dim-s {
      background-color: rgba(255,107,0,0.08);
      border-color: rgba(255,107,0,0.22);
      color: #ff6b00;
    }

    /* ★ Firestore image ★ */
    .asset-img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      display: block;
      background-color: #0c1828;
    }
    .asset-footer-row {
      padding: 10px 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .asset-ready {
      font-size: 11px;
      font-weight: 700;
      color: #aaff00;
    }

    /* ★ DOWNLOAD BUTTON ★ */
    .dl-btn {
      display: inline-block;
      background-color: rgba(0,200,255,0.12);
      border: 1px solid rgba(0,200,255,0.30);
      border-radius: 7px;
      padding: 7px 14px;
      font-size: 12px;
      font-weight: 700;
      color: #00c8ff !important;
      text-decoration: none;
    }

    /* Firestore pill */
    .firestore-pill {
      background-color: rgba(0,200,255,0.03);
      border: 1px solid rgba(0,200,255,0.12);
      border-radius: 10px;
      padding: 12px 16px;
      margin-top: 16px;
    }
    .fp-title { font-size: 12px; font-weight: 700; color: #00c8ff; margin-bottom: 3px; }
    .fp-sub   { font-size: 11px; color: #3d5068; }
    .fp-id    { font-family: monospace; color: #eef4ff; }

    /* ══════════════════════════
       CAPTION SECTION
    ══════════════════════════ */
    .caption-section {
      background-color: #0a1020;
      border: 1px solid rgba(0,200,255,0.12);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .caption-header {
      padding: 16px 22px;
      border-bottom: 1px solid rgba(0,200,255,0.09);
      background: linear-gradient(90deg, rgba(0,200,255,0.05), transparent);
    }
    .caption-header-title { font-size: 15px; font-weight: 800; color: #eef4ff; }
    .caption-header-sub   { font-size: 12px; color: #3d5068; margin-top: 2px; }

    .caption-body { padding: 22px; }

    /* Platform label tabs */
    .platform-label {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #00c8ff;
      margin-bottom: 10px;
      padding: 5px 12px;
      background-color: rgba(0,200,255,0.08);
      border: 1px solid rgba(0,200,255,0.22);
      border-radius: 100px;
      display: inline-block;
    }
    .platform-label-story {
      color: #ff6b00;
      background-color: rgba(255,107,0,0.08);
      border-color: rgba(255,107,0,0.22);
    }
    .platform-label-linkedin {
      color: #aaff00;
      background-color: rgba(170,255,0,0.07);
      border-color: rgba(170,255,0,0.22);
    }

    .caption-box {
      font-size: 14px;
      line-height: 2;
      color: rgba(238,244,255,0.90);
      background-color: #0c1220;
      border: 1px solid rgba(0,200,255,0.09);
      border-radius: 10px;
      padding: 18px 20px;
      margin-bottom: 20px;
      white-space: pre-line;
    }

    /* ══════════════════════════
       HASHTAGS
    ══════════════════════════ */
    .hashtags-section { margin-bottom: 20px; }
    .hashtag-table { width: 100%; border-collapse: collapse; }
    .hashtag-chips-flex { display: flex; flex-wrap: wrap; gap: 8px; }
    .hashtag-chip {
      display: inline-block;
      padding: 10px 14px;
      border-radius: 100px;
      font-size: 13px;
      font-weight: 700;
      text-align: center;
      vertical-align: middle;
      white-space: nowrap;
    }
    .hc-1 { background-color: rgba(0,200,255,0.09);  border: 1px solid rgba(0,200,255,0.28);  color: #00c8ff; }
    .hc-2 { background-color: rgba(255,107,0,0.09);  border: 1px solid rgba(255,107,0,0.28);  color: #ff6b00; }
    .hc-3 { background-color: rgba(170,255,0,0.07);  border: 1px solid rgba(170,255,0,0.25);  color: #aaff00; }
    .hc-4 { background-color: rgba(245,197,24,0.08); border: 1px solid rgba(245,197,24,0.25); color: #f5c518; }
    .hc-5 { background-color: rgba(155,92,255,0.09); border: 1px solid rgba(155,92,255,0.25); color: #bb88ff; }
    .hc-rank { font-size: 10px; font-weight: 800; opacity: 0.6; display: block; margin-top: 2px; }

    .hashtags-all-box {
      background-color: #0c1220;
      border: 1px solid rgba(0,200,255,0.09);
      border-radius: 10px;
      padding: 14px 16px;
      font-size: 13px;
      color: rgba(238,244,255,0.55);
      line-height: 2;
      letter-spacing: 0.5px;
      margin-top: 10px;
    }

    /* ══════════════════════════
       POSTING GUIDE
    ══════════════════════════ */
    .tips-table { width: 100%; border-collapse: separate; border-spacing: 12px; margin: 0 -12px; }
    .tip-card {
      background-color: #0a1020;
      border: 1px solid rgba(0,200,255,0.09);
      border-radius: 12px;
      padding: 16px;
      vertical-align: top;
      width: 50%;
    }
    .tip-card-do   { border-top: 2px solid #aaff00; }
    .tip-card-dont { border-top: 2px solid #ff6b00; }
    .tip-head {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 12px;
    }
    .tip-do   { color: #aaff00; }
    .tip-dont { color: #ff6b00; }
    .tip-list { list-style: none; padding: 0; margin: 0; }
    .tip-list li {
      font-size: 12px;
      color: rgba(238,244,255,0.72);
      padding: 5px 0;
      padding-left: 16px;
      position: relative;
      line-height: 1.5;
      border-bottom: 1px solid rgba(0,200,255,0.04);
    }
    .tip-list li:last-child { border-bottom: none; }
    .tip-do-item::before   { content: '✓'; color: #aaff00; font-weight: 800; position: absolute; left: 0; }
    .tip-dont-item::before { content: '✗'; color: #ff6b00; font-weight: 800; position: absolute; left: 0; }

    /* ══════════════════════════
       ACTION BUTTONS
       ★ All white text on dark ★
    ══════════════════════════ */
    .actions-section { margin-bottom: 24px; }
    .btn-table { width: 100%; border-collapse: separate; border-spacing: 10px; margin: 0 -10px; }

    .btn-primary {
      display: block;
      width: 100%;
      padding: 15px 20px;
      background: linear-gradient(135deg, #00c8ff, #005a85);
      color: #ffffff !important;
      font-size: 14px;
      font-weight: 800;
      text-align: center;
      text-decoration: none;
      border-radius: 12px;
      letter-spacing: 0.3px;
    }
    .btn-accent {
      display: block;
      width: 100%;
      padding: 15px 20px;
      background: linear-gradient(135deg, #ff6b00, #bb2200);
      color: #ffffff !important;
      font-size: 14px;
      font-weight: 800;
      text-align: center;
      text-decoration: none;
      border-radius: 12px;
      letter-spacing: 0.3px;
    }
    .btn-green {
      display: block;
      width: 100%;
      padding: 15px 20px;
      background: linear-gradient(135deg, #3a8f00, #265f00);
      color: #ffffff !important;
      font-size: 14px;
      font-weight: 800;
      text-align: center;
      text-decoration: none;
      border-radius: 12px;
      letter-spacing: 0.3px;
    }
    .btn-gold {
      display: block;
      width: 100%;
      padding: 15px 20px;
      background: linear-gradient(135deg, #b88a00, #7a5c00);
      color: #ffffff !important;
      font-size: 14px;
      font-weight: 800;
      text-align: center;
      text-decoration: none;
      border-radius: 12px;
      letter-spacing: 0.3px;
    }

    /* ══════════════════════════
       FOOTER
    ══════════════════════════ */
    .footer-sig {
      background-color: #0c1220;
      border: 1px solid rgba(0,200,255,0.09);
      border-radius: 16px;
      padding: 26px 28px;
    }
    .fs-cta {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 26px;
      letter-spacing: 2px;
      color: #eef4ff;
      line-height: 1;
      margin-bottom: 5px;
    }
    .fs-sub  { font-size: 13px; color: #3d5068; margin-bottom: 14px; }
    .fs-pill {
      display: inline-block;
      font-size: 11px;
      color: #3d5068;
      background-color: #0a1020;
      border: 1px solid rgba(0,200,255,0.09);
      border-radius: 6px;
      padding: 4px 10px;
      margin: 2px 4px 2px 0;
    }
    .fs-sig-name  { font-family: 'Bebas Neue', Arial, sans-serif; font-size: 24px; letter-spacing: 2px; color: #eef4ff; line-height: 1; }
    .fs-sig-title { font-size: 11px; font-weight: 700; color: #3d5068; letter-spacing: 1px; text-transform: uppercase; margin-top: 3px; }
    .fs-sig-brand { font-size: 12px; font-weight: 800; color: #00c8ff; text-transform: uppercase; letter-spacing: 1px; margin-top: 5px; }

    /* Colour strip */
    .color-strip {
      height: 5px;
      background: linear-gradient(90deg, #00c8ff 0%, #aaff00 33%, #ff6b00 66%, #f5c518 100%);
      border-radius: 0 0 4px 4px;
      margin-top: 22px;
    }

    /* ══════════════════════════
       RESPONSIVE
    ══════════════════════════ */
    @media only screen and (max-width: 600px) {
      .email-container  { width: 100% !important; }
      .main-card        { padding: 18px 14px !important; }
      .logo-header      { padding: 14px 16px !important; }
      .topbar           { padding: 12px 16px !important; }
      .hero-headline    { font-size: 36px !important; }
