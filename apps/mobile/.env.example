# Mobile API used by the Expo client.
EXPO_PUBLIC_MOBILE_API_URL=https://api-mobile.bergmantri.com
EXPO_PUBLIC_WEB_APP_URL=https://bergmantri.com
EXPO_PUBLIC_ENV=development

# Public Mapbox token embedded in the Expo bundle. Never use a secret download
# token here; this must be a public pk.* access token.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Expo SDK 57 installs expo/fetch as global fetch by default. Keep React
# Native's fetch implementation instead: Expo Fetch's iOS RequestQueue is the
# native crash path observed in App Store build 52 during request cancellation.
EXPO_PUBLIC_USE_RN_FETCH=1

# Optional Firebase client overrides. If omitted, the app loads the public
# Firebase client configuration from the backend.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Keep disabled except for an approved App Store review flow.
EXPO_PUBLIC_APPLE_REVIEW_LOGIN_ENABLED=false

# Build-time native Android Maps key. Never commit the real value.
GOOGLE_MAPS_ANDROID_API_KEY=
