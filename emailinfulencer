<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8"/>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="x-apple-disable-message-reformatting"/>
  <title>Bergman Bengaluru 2026 — Reel Brief</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Bebas+Neue&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background-color: #05080e;
      color: #eef4ff;
      margin: 0; padding: 0;
      -webkit-text-size-adjust: 100%;
    }

    .email-wrapper   { width: 100%; background-color: #05080e; }
    .email-container { max-width: 640px; margin: 0 auto; background-color: #05080e; }

    /* ══════════════════════
       LOGO HEADER
    ══════════════════════ */
    .logo-header {
      background-color: #080d18;
      border-bottom: 2px solid rgba(0,200,255,0.15);
      padding: 14px 20px;
    }
    .logo-header-table { width: 100%; border-collapse: collapse; }
    .logo-td-left { vertical-align: middle; }
    .logo-td-right { vertical-align: middle; text-align: right; white-space: nowrap; }
    .logo-img  { width: 72px; height: 72px; object-fit: contain; display: block; }
    .logo-right-badge {
      display: inline-block;
      background: linear-gradient(135deg, #ff6b00, #bb2200);
      color: #fff; font-size: 10px; font-weight: 800;
      letter-spacing: 1.5px; text-transform: uppercase;
      padding: 7px 18px; border-radius: 100px;
    }

    /* ══════════════════════
       DEADLINE BANNER
    ══════════════════════ */
    .deadline-banner {
      background: linear-gradient(90deg, rgba(245,197,24,0.10), rgba(255,107,0,0.07));
      border-bottom: 2px solid rgba(245,197,24,0.30);
      padding: 12px 20px;
    }
    .dl-table { width: 100%; border-collapse: collapse; }
    .dl-td-icon { width: 46px; vertical-align: middle; padding-right: 10px; }
    .dl-td-text { vertical-align: middle; }
    .dl-td-right { vertical-align: middle; text-align: right; white-space: nowrap; padding-left: 10px; }
    .dl-icon-wrap {
      width: 36px; height: 36px; border-radius: 10px;
      background-color: rgba(245,197,24,0.12);
      border: 1px solid rgba(245,197,24,0.30);
      display: block;
      font-size: 18px;
      line-height: 36px; text-align: center;
    }
    .dl-label {
      font-size: 9px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 2px;
      color: #f5c518; margin-bottom: 3px;
    }
    .dl-date {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 20px; letter-spacing: 2px;
      color: #eef4ff; line-height: 1;
    }
    .dl-date span { color: #f5c518; }
    .dl-right {
      display: inline-block;
      background-color: rgba(245,197,24,0.10);
      border: 1px solid rgba(245,197,24,0.30);
      border-radius: 100px; padding: 5px 14px;
      font-size: 10px; font-weight: 800;
      color: #f5c518; white-space: nowrap;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.6} }

    /* ══════════════════════
       HERO
    ══════════════════════ */
    .hero {
      background: linear-gradient(160deg, #080f1e 0%, #05080e 60%, #0a0500 100%);
      padding: 40px 32px 34px;
      border-left: 1px solid rgba(0,200,255,0.09);
      border-right: 1px solid rgba(0,200,255,0.09);
      text-align: center;
    }
    .hero-pill {
      display: inline-block;
      background-color: rgba(0,200,255,0.08);
      border: 1px solid rgba(0,200,255,0.28);
      border-radius: 100px; padding: 6px 18px;
      font-size: 10px; font-weight: 800;
      letter-spacing: 2.5px; text-transform: uppercase;
      color: #00c8ff; margin-bottom: 18px;
    }
    .hero-eyebrow {
      font-size: 11px; font-weight: 700;
      letter-spacing: 3px; text-transform: uppercase;
      color: #ff6b00; margin-bottom: 10px;
    }
    .hero-headline {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 54px; line-height: 0.93;
      letter-spacing: 2px; margin-bottom: 18px;
    }
    .hl-w { display: block; color: #eef4ff; }
    .hl-p { display: block; color: #00c8ff; }
    .hl-a { display: block; color: #ff6b00; }
    .hero-sub {
      font-size: 14px; color: #3d5068;
      line-height: 1.8; max-width: 480px;
      margin: 0 auto 26px;
    }
    .date-strip {
      display: inline-flex; align-items: stretch;
      border: 1px solid rgba(0,200,255,0.20);
      border-radius: 12px; overflow: hidden;
    }
    .ds-item {
      padding: 12px 24px; text-align: center;
      border-right: 1px solid rgba(0,200,255,0.15);
      background-color: rgba(0,200,255,0.03);
    }
    .ds-item:last-child { border-right: none; }
    .ds-val {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 22px; letter-spacing: 1px; line-height: 1; color: #00c8ff;
    }
    .ds-lbl {
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 1.5px;
      color: #3d5068; margin-top: 3px;
    }

    /* ══════════════════════
       MAIN CARD
    ══════════════════════ */
    .main-card {
      background-color: #080d18;
      border: 1px solid rgba(0,200,255,0.09);
      border-top: none; padding: 36px 32px;
    }
    .divider {
      height: 1px;
      background: linear-gradient(90deg, #00c8ff, #aaff00, #ff6b00, transparent);
      margin: 28px 0; border: none;
    }
    .section-label {
      font-size: 10px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 2px;
      color: #3d5068; margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(0,200,255,0.08);
    }

    /* ══════════════════════
       GREETING CARD
    ══════════════════════ */
    .greeting-card {
      background-color: #0c1220;
      border: 1px solid rgba(0,200,255,0.09);
      border-left: 3px solid #00c8ff;
      border-radius: 14px; padding: 26px 28px;
    }
    .gc-to {
      font-size: 11px; font-weight: 700; color: #3d5068;
      letter-spacing: 2px; text-transform: uppercase; margin-bottom: 6px;
    }
    .gc-name {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 30px; letter-spacing: 2px;
      color: #eef4ff; line-height: 1; margin-bottom: 18px;
    }
    .gc-name span { color: #00c8ff; }
    .gc-body {
      font-size: 14.5px; line-height: 1.9;
      color: rgba(238,244,255,0.85);
    }
    .gc-body p { margin-bottom: 14px; }
    .gc-body p:last-child { margin-bottom: 0; }
    .gc-highlight { color: #00c8ff; font-weight: 700; }
    .gc-accent    { color: #ff6b00; font-weight: 700; }

    /* Ask box */
    .ask-box {
      background-color: rgba(255,107,0,0.07);
      border: 1px solid rgba(255,107,0,0.25);
      border-radius: 12px; padding: 16px 20px; margin: 16px 0;
    }
    .ask-box-head {
      font-size: 11px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 1.5px;
      color: #ff6b00; margin-bottom: 10px;
    }
    .ask-list { list-style: none; padding: 0; margin: 0; }
    .ask-list li {
      font-size: 13px; color: rgba(238,244,255,0.82);
      padding: 7px 0 7px 18px; position: relative;
      border-bottom: 1px solid rgba(255,107,0,0.08); line-height: 1.5;
    }
    .ask-list li:last-child { border-bottom: none; }
    .ask-list li::before { content: '→'; color: #ff6b00; font-weight: 800; position: absolute; left: 0; }

    /* Brand warning box */
    .brand-warning {
      background-color: rgba(245,197,24,0.06);
      border: 1px solid rgba(245,197,24,0.28);
      border-left: 3px solid #f5c518;
      border-radius: 0 10px 10px 0;
      padding: 14px 18px; margin: 16px 0;
    }
    .bw-head {
      font-size: 11px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 1.5px;
      color: #f5c518; margin-bottom: 8px;
    }
    .bw-text {
      font-size: 13px; color: rgba(238,244,255,0.82); line-height: 1.7;
    }
    .bw-text strong { color: #f5c518; }

    /* Best time to post box */
    .post-timing-card {
      background-color: rgba(170,255,0,0.04);
      border: 1px solid rgba(170,255,0,0.18);
      border-radius: 12px; padding: 18px 20px; margin: 16px 0;
    }
    .pt-head {
      font-size: 11px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 1.5px;
      color: #aaff00; margin-bottom: 14px;
    }
    .pt-grid { width: 100%; border-collapse: separate; border-spacing: 8px; }
    .pt-cell {
      background-color: rgba(170,255,0,0.06);
      border: 1px solid rgba(170,255,0,0.15);
      border-radius: 8px; padding: 10px 12px;
      text-align: center; vertical-align: top; width: 33%;
    }
    .pt-day { font-size: 11px; font-weight: 800; color: #aaff00; margin-bottom: 4px; }
    .pt-time { font-size: 12px; color: rgba(238,244,255,0.80); line-height: 1.5; }
    .pt-peak {
      display: inline-block; margin-top: 5px;
      background-color: rgba(170,255,0,0.12);
      border: 1px solid rgba(170,255,0,0.25);
      border-radius: 100px; padding: 2px 8px;
      font-size: 9px; font-weight: 800;
      color: #aaff00; letter-spacing: 1px; text-transform: uppercase;
    }
    .pt-note {
      font-size: 11px; color: #3d5068; margin-top: 12px;
      padding-top: 10px; border-top: 1px solid rgba(170,255,0,0.10);
      line-height: 1.6;
    }

    /* Deadline reminder inline */
    .deadline-inline {
      background: linear-gradient(90deg, rgba(245,197,24,0.08), rgba(255,107,0,0.05));
      border: 1px solid rgba(245,197,24,0.25);
      border-radius: 10px; padding: 14px 18px; margin: 16px 0;
    }
    .di-table  { width: 100%; border-collapse: collapse; }
    .di-td-icon { vertical-align: middle; padding-right: 12px; width: 34px; font-size: 24px; }
    .di-td-text { vertical-align: middle; font-size: 13px; color: rgba(238,244,255,0.85); line-height: 1.6; }
    .di-icon { font-size: 24px; flex-shrink: 0; }
    .di-text { font-size: 13px; color: rgba(238,244,255,0.85); line-height: 1.6; }
    .di-text strong { color: #f5c518; }

    /* Code box */
    .code-box {
      background: linear-gradient(135deg, rgba(0,200,255,0.08), rgba(0,200,255,0.03));
      border: 1px solid rgba(0,200,255,0.28);
      border-radius: 12px; padding: 18px 20px; margin: 16px 0; text-align: center;
    }
    .code-label {
      font-size: 10px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 2px; color: #3d5068; margin-bottom: 10px;
    }
    .code-value {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 44px; letter-spacing: 10px; color: #00c8ff; line-height: 1;
    }
    .code-sub { font-size: 11px; color: #3d5068; margin-top: 8px; }

    /* Signature */
    .ol-sig {
      margin-top: 22px; padding-top: 18px;
      border-top: 1px solid rgba(0,200,255,0.09);
    }
    .ol-sig-regards { font-size: 12px; color: #3d5068; margin-bottom: 4px; }
    .ol-sig-name {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 26px; letter-spacing: 2px; color: #eef4ff; line-height: 1;
    }
    .ol-sig-title {
      font-size: 11px; font-weight: 700; color: #3d5068;
      letter-spacing: 1px; text-transform: uppercase; margin-top: 3px;
    }
    .ol-sig-brand {
      font-size: 12px; font-weight: 800; color: #00c8ff;
      letter-spacing: 1px; text-transform: uppercase; margin-top: 5px;
    }

    /* ══════════════════════
       REEL CARD
    ══════════════════════ */
    .reel-card {
      background-color: #0c1220;
      border: 1px solid rgba(0,200,255,0.10);
      border-radius: 16px; overflow: hidden;
    }
    .reel-header {
      background: linear-gradient(90deg, rgba(0,200,255,0.07), rgba(255,107,0,0.04));
      border-bottom: 1px solid rgba(0,200,255,0.12); padding: 20px 24px;
    }
    .reel-header-top {
      width: 100%; border-collapse: collapse; margin-bottom: 14px;
    }
    .rh-td-icon { vertical-align: middle; padding-right: 14px; width: 46px; }
    .rh-td-info { vertical-align: middle; }
    .rh-td-badge { vertical-align: middle; text-align: right; white-space: nowrap; padding-left: 14px; }
    .reel-big-icon { font-size: 32px; }
    .reel-main-title {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 22px; letter-spacing: 2px; color: #eef4ff; line-height: 1;
    }
    .reel-sub-title { font-size: 12px; color: #3d5068; margin-top: 3px; }
    .reel-dur-badge {
      margin-left: auto;
      background-color: rgba(255,107,0,0.12);
      border: 1px solid rgba(255,107,0,0.28);
      border-radius: 100px; padding: 5px 14px;
      font-size: 11px; font-weight: 800; color: #ff6b00; white-space: nowrap;
    }
    .reel-spec-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .spec-pill {
      display: inline-block; padding: 4px 12px; border-radius: 100px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.5px;
    }
    .sp-p    { background-color: rgba(0,200,255,0.08);  border: 1px solid rgba(0,200,255,0.22);  color: #00c8ff; }
    .sp-a    { background-color: rgba(255,107,0,0.08);  border: 1px solid rgba(255,107,0,0.22);  color: #ff6b00; }
    .sp-g    { background-color: rgba(170,255,0,0.07);  border: 1px solid rgba(170,255,0,0.22);  color: #aaff00; }
    .sp-gold { background-color: rgba(245,197,24,0.07); border: 1px solid rgba(245,197,24,0.22); color: #f5c518; }

    .music-bar {
      background-color: rgba(170,255,0,0.05);
      border-bottom: 1px solid rgba(170,255,0,0.10);
      padding: 10px 24px; font-size: 12px; font-weight: 700; color: #aaff00;
    }
    .reel-body { padding: 24px; }

    /* Scene card */
    .scene-card {
      background-color: #080d18;
      border: 1px solid rgba(0,200,255,0.08);
      border-radius: 12px; margin-bottom: 10px; overflow: hidden;
    }
    .scene-head {
      width: 100%; border-collapse: collapse;
      padding: 12px 16px;
      border-bottom: 1px solid rgba(0,200,255,0.06);
      background-color: rgba(0,200,255,0.02);
    }
    .sh-td-num  { vertical-align: middle; padding-right: 12px; width: 42px; }
    .sh-td-info { vertical-align: middle; }
    .sh-td-time { vertical-align: middle; text-align: right; white-space: nowrap; padding-left: 8px; }
    .scene-num {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 30px; letter-spacing: 1px; line-height: 1;
      color: #00c8ff; min-width: 36px;
    }
    .scene-info { flex: 1; }
    .scene-title { font-size: 13px; font-weight: 800; color: #eef4ff; line-height: 1; }
    .scene-shot  { font-size: 11px; color: #3d5068; margin-top: 3px; }
    .scene-time {
      background-color: rgba(0,200,255,0.08);
      border: 1px solid rgba(0,200,255,0.20);
      border-radius: 100px; padding: 3px 10px;
      font-size: 10px; font-weight: 800; color: #00c8ff;
      font-family: monospace; white-space: nowrap;
    }
    .camera-box {
      background-color: rgba(0,200,255,0.04);
      border-left: 3px solid rgba(0,200,255,0.30);
      padding: 10px 14px; margin: 14px 16px 10px;
      border-radius: 0 8px 8px 0;
    }
    .camera-label {
      font-size: 9px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 2px;
      color: #00c8ff; margin-bottom: 5px;
    }
    .camera-text { font-size: 12px; color: rgba(238,244,255,0.70); line-height: 1.6; }
    .dialogue-box {
      background-color: rgba(255,107,0,0.05);
      border-left: 3px solid #ff6b00;
      padding: 12px 16px; margin: 0 16px 16px;
      border-radius: 0 8px 8px 0;
    }
    .dialogue-label {
      font-size: 9px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 2px;
      color: #ff6b00; margin-bottom: 7px;
    }
    .dialogue-text {
      font-size: 15px; color: rgba(238,244,255,0.92);
      line-height: 1.9; font-style: italic;
    }
    .dialogue-text strong { color: #eef4ff; font-style: normal; font-weight: 800; }

    /* Overlay box */
    .overlay-box {
      background: linear-gradient(135deg, #0a1828, #060e1c);
      border: 1px solid rgba(0,200,255,0.20);
      border-radius: 10px; padding: 14px 18px;
      margin: 0 16px 16px; text-align: center;
    }
    .overlay-label {
      font-size: 9px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 2px;
      color: #3d5068; margin-bottom: 10px;
    }
    .overlay-line {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 20px; letter-spacing: 2px; color: #eef4ff; line-height: 1.2;
    }
    .overlay-line span { color: #00c8ff; }
    .overlay-sub { font-size: 12px; color: #3d5068; margin-top: 5px; font-weight: 600; }

    /* Final scene */
    .final-scene {
      background: linear-gradient(135deg, #091628, #05080e);
      border: 1px solid rgba(0,200,255,0.20);
      border-radius: 12px; overflow: hidden; margin-top: 10px;
    }
    .fs-top {
      background: linear-gradient(90deg, rgba(0,200,255,0.08), transparent);
      border-bottom: 1px solid rgba(0,200,255,0.12);
      padding: 14px 20px; width: 100%; border-collapse: collapse;
    }
    .fst-td-icon  { vertical-align: middle; padding-right: 10px; width: 24px; }
    .fst-td-label { vertical-align: middle; }
    .fst-td-tag   { vertical-align: middle; text-align: right; white-space: nowrap; padding-left: 10px; }
    .fs-top-label {
      font-size: 10px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 2px; color: #00c8ff;
    }
    .fs-top-tag {
      margin-left: auto;
      background-color: rgba(0,200,255,0.10);
      border: 1px solid rgba(0,200,255,0.25);
      border-radius: 100px; padding: 3px 10px;
      font-size: 10px; font-weight: 800; color: #00c8ff;
    }
    .fs-body { padding: 20px; text-align: center; }
    .fs-logo-row {
      margin: 0 auto 16px; border-collapse: collapse;
    }
    .fslr-td-logo { vertical-align: middle; padding-right: 10px; }
    .fslr-td-word { vertical-align: middle; }
    .fs-logo-img { width: 40px; height: 40px; object-fit: contain; display: block; }
    .fs-logo-wordmark {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 28px; letter-spacing: 5px; line-height: 1;
    }
    .fs-berg { color: #eef4ff; }
    .fs-man  { color: #00c8ff; }
    .fs-event-name {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 26px; letter-spacing: 2px;
      color: #eef4ff; line-height: 1; margin-bottom: 4px;
    }
    .fs-event-name span { color: #00c8ff; }
    .fs-date-line { font-size: 13px; color: rgba(238,244,255,0.70); margin-bottom: 14px; }
    .fs-code-pill {
      background: linear-gradient(135deg, rgba(0,200,255,0.10), rgba(0,200,255,0.05));
      border: 1px solid rgba(0,200,255,0.28);
      border-radius: 10px; padding: 12px 20px; margin: 10px 0 14px;
    }
    .fs-code-label {
      font-size: 10px; font-weight: 800; color: #3d5068;
      letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 6px;
    }
    .fs-code-val {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 32px; letter-spacing: 8px; color: #00c8ff; line-height: 1;
    }
    .fs-url { font-size: 14px; font-weight: 700; color: #aaff00; margin-bottom: 6px; }
    .cta-line {
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-size: 22px; letter-spacing: 2px; color: #ff6b00; margin-top: 14px;
    }

    /* ══════════════════════
       HASHTAGS
    ══════════════════════ */
    .hashtag-table { width: 100%; border-collapse: separate; border-spacing: 6px; }
    .htag {
      padding: 9px 10px; border-radius: 100px;
      font-size: 11px; font-weight: 700; text-align: center; vertical-align: middle;
    }
    .ht-1 { background-color: rgba(0,200,255,0.09);  border: 1px solid rgba(0,200,255,0.28);  color: #00c8ff; }
    .ht-2 { background-color: rgba(255,107,0,0.09);  border: 1px solid rgba(255,107,0,0.28);  color: #ff6b00; }
    .ht-3 { background-color: rgba(170,255,0,0.07);  border: 1px solid rgba(170,255,0,0.25);  color: #aaff00; }
    .ht-4 { background-color: rgba(245,197,24,0.08); border: 1px solid rgba(245,197,24,0.25); color: #f5c518; }
    .ht-5 { background-color: rgba(155,92,255,0.09); border: 1px solid rgba(155,92,255,0.25); color: #bb88ff; }
