import React, { useState, useEffect, useCallback, useMemo, Suspense } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import * as z from 'zod';
import { useToast } from '@/hooks/use-toast';
import {
  HandHelping, ClipboardList, Users, CalendarDays, Info, Loader2, KeyRound, Send, CheckCircle, Search as SearchIcon, UserCircle as UserIcon, Mail, Hash, Smartphone, ChevronDown, ChevronUp, Bike, RefreshCw, Ticket, User as UserLucide, AlertTriangle, UserCheck, Medal, Shirt, Edit2, XCircle, UtensilsCrossed, Package, PackageOpen
} from 'lucide-react';
import { useAuth } from '@/context/AuthContext';
import { format as formatDateFns, parseISO } from 'date-fns';
import { Badge } from '@/components/ui/badge';
import type { EventCalendarEntry, EventParticipant, PaidFoodCoupon, PaidFoodOrder } from '@/lib/types';
import {
  bikeCheckInAction,
  manualBikeCheckOutAction,
  searchParticipantForBikeAction,
  getCheckInStatsForEventAction,
  searchParticipantsForCheckInAction,
  markItemIssuedAction,
  updateParticipantTshirtSizeAction,
  resetParticipantCheckInStatusAction,
  resetIssuedItemStatusAction,
  getCheckedInParticipantsForEventAction,
  assignLockerAction,
  returnLockerAction,
} from '@/lib/actions/volunteerActions';
import { redeemFoodCouponAction } from '@/lib/actions/paidFoodActions';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Alert, AlertTitle, AlertDescription } from '@/components/ui/alert';
